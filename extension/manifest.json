{
  "manifest_version": 3,
  "name": "Daylight",
  "version": "1.0.0",
  "description": "A small slider for making websites lighter or darker, with colors that work together.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Daylight",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["colors.js", "ui.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true,
    "match_origin_as_fallback": true
  }]
}
